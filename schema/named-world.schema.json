{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/naming/named-world",
  "title": "Named world produced by the naming pass",
  "description": "The input world preserved, plus the naming metadata block. Which entities are selected for naming depends on the worksheet the box builds from the world, so selected-name coverage, namespace uniqueness and sign spelling are checked against that worksheet in code at the public boundary (src/validate/named-world.ts), not here.",
  "allOf": [
    { "$ref": "./world-state" },
    {
      "type": "object",
      "required": ["meta"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["naming"],
          "properties": {
            "naming": {
              "type": "object",
              "additionalProperties": false,
              "required": ["theme", "model", "namedAt"],
              "properties": {
                "theme": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "minLength": 1 },
                "namedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
